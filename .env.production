# =================================================================
# TukangBaik — Frontend Production
# Aktif saat: npm run build / npm start
# Ganti semua CHANGE_ME sebelum deploy
# =================================================================

# API Gateway — URL production server
NEXT_PUBLIC_API_URL=https://api.CHANGE_ME_your_domain.com

# OAuth — daftarkan domain production di Google & Facebook Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=CHANGE_ME

# Label environment
NEXT_PUBLIC_ENV=production
